              "escape": {
                "kind": "meta_loop",
                "impl_ref": "packages/aflowkit@1.0.0/hatches/mcts_controller.py",
                "reason": "MCTS 元层搜索本体：UCB 选择（价值+成本+探索项合并）、节点访问计数、价值回传、分支隔离。标准 DSL 只能描述一次执行，无法描述『搜索多个拓扑并按价值选择』（卡⑥b-2），评估结果回灌搜索状态（价值更新/UCB 计数）亦无可变状态位（卡⑥b-5）。DSL 侧仅提供价值最大父节点作基线选择。",
                "owner": "lang-team",
                "share_budget_pct": 20
