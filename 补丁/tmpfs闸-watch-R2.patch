+def probe_local_tmp_mb():
+    """本机 /tmp 可用（MiB）。statvfs 本地读 f_bavail（tmpfs 无 root 保留，与 df 同值）。
+    异常 → (-1, True)=盘点失败（fail-closed 口径；与真写满同码 A4L:tmp 但文案强制区分）。"""
+    try:
+        st = os.statvfs("/tmp")
+        return st.f_bavail * st.f_frsize // 1048576, False
+    except Exception:
+        return -1, True
+
